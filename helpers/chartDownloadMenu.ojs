/**
 * chartDownloadMenu.ojs
 *
 * Wraps a chart element with a split-button download menu offering
 * PNG, SVG, and CSV exports. Built for OJS notebooks under
 * notebooks/climateRationale/ but kept dependency-free so it can
 * be reused anywhere htl.html is available.
 *
 * Primary click  = PNG (2× device-pixel-ratio for crisp output).
 * Caret dropdown = SVG (vector, editable in Illustrator/Inkscape)
 *                + CSV (the dataframe backing the chart).
 *
 * The split-button sits BELOW the chart.
 *
 * See playbook/handovers/climateRationale/dispatches/
 *     2026-05-21_chart-download-menu.md for the design rationale
 *     and validation checklist.
 */


/**
 * Convert an array of objects to a CSV string per RFC 4180.
 * \r\n line endings; fields containing comma / quote / CR / LF
 * are quoted and internal quotes are doubled. Null and undefined
 * become empty strings. The UTF-8 BOM that Excel needs to read
 * diacritics is added at blob-build time, not here.
 *
 * @param {Array<object>} data
 * @param {Array<string>} [columns] - explicit column order;
 *                                    otherwise Object.keys(data[0]).
 * @returns {string}
 */
function _chartDownloadMenu_toCsv(data, columns) {
  if (!data || !data.length) return "";
  const cols = columns || Object.keys(data[0]);
  const escape = (val) => {
    if (val == null) return "";
    const str = String(val);
    const needsQuote =
      str.indexOf(",")  !== -1 ||
      str.indexOf('"')  !== -1 ||
      str.indexOf("\n") !== -1 ||
      str.indexOf("\r") !== -1;
    if (!needsQuote) return str;
    return '"' + str.split('"').join('""') + '"';
  };
  const header = cols.map(escape).join(",");
  const rows = data.map((row) => cols.map((c) => escape(row[c])).join(","));
  return [header].concat(rows).join("\r\n");
}


/**
 * Trigger a browser download for a Blob + filename. Anchored to
 * document.body briefly (Safari refuses if the anchor isn't in
 * the DOM) and revokes the object URL once the click fires.
 */
function _chartDownloadMenu_triggerDownload(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}


/**
 * Locate the SVG element to export. Plot.plot returns an SVG
 * directly; some charts wrap it in a <figure> or <div>. Returns
 * null if no SVG is found (CSV export still works in that case;
 * PNG/SVG menu items get disabled).
 */
function _chartDownloadMenu_findSvg(chartElement) {
  if (!chartElement) return null;
  if (chartElement.tagName && chartElement.tagName.toLowerCase() === "svg") return chartElement;
  if (typeof chartElement.querySelector === "function") return chartElement.querySelector("svg");
  return null;
}


/**
 * True when PNG capture needs html-to-image — anything that isn't a
 * bare <svg> or a figure containing exactly one <svg> and only
 * <style> siblings. Plot.plot figures with `title:` (which renders an
 * <h2>) fall into this bucket so the title text makes it into the PNG.
 */
function _chartDownloadMenu_needsCompositePng(el) {
  if (!el || !el.tagName) return false;
  const tag = el.tagName.toLowerCase();
  if (tag === "svg") return false;
  if (tag === "figure") {
    const directChildren = Array.from(el.children);
    const svgs = directChildren.filter(c => c.tagName && c.tagName.toLowerCase() === "svg");
    const others = directChildren.filter(c => {
      if (!c.tagName) return false;
      const t = c.tagName.toLowerCase();
      return t !== "svg" && t !== "style";
    });
    return svgs.length !== 1 || others.length > 0;
  }
  return true;
}

/**
 * True when SVG export would be lossy — multiple SVGs inside (we'd
 * serialise only the first), or zero SVGs (nothing to serialise).
 * A single inner SVG with HTML siblings is NOT lossy: the user gets
 * an honest "chart-only SVG" without the legend/caption, which is
 * how vector exports work everywhere else.
 */
function _chartDownloadMenu_isSvgLossy(el) {
  if (!el) return true;
  if (el.tagName && el.tagName.toLowerCase() === "svg") return false;
  if (typeof el.querySelectorAll !== "function") return true;
  const allSvgs = el.querySelectorAll("svg");
  return allSvgs.length !== 1;
}


/**
 * Lazy-load html-to-image (MIT, ~30 KB ESM from esm.sh). Cached on the
 * function itself so subsequent calls reuse the same promise — first
 * PNG click on a composite chart pays the import latency, the rest are
 * instant. Top-level `await import()` would block every dependent cell
 * until the CDN responds; the lazy form keeps cell evaluation snappy.
 */
function _chartDownloadMenu_loadHtmlToImage() {
  if (!_chartDownloadMenu_loadHtmlToImage._pending) {
    _chartDownloadMenu_loadHtmlToImage._pending =
      import("https://esm.sh/html-to-image@1.11.13");
  }
  return _chartDownloadMenu_loadHtmlToImage._pending;
}


/**
 * Build an async PNG capture function for a composite element. Returns
 * `() => Promise<Blob>` suitable for the `pngOverride` hook below.
 *
 * Block-container quirk: any block-level wrapper around a Plot.plot
 * chart inflates to its parent column (Plot.plot's `title:` renders as
 * an <h2> whose bottom-border anchors at the parent's full width), so
 * html-to-image would otherwise capture the empty page column. We
 * temporarily force the rootElement to display:inline-block so layout
 * shrinks to the chart's content width, capture, then restore in
 * `finally` so the live page doesn't reflow visibly.
 */
function compositePng(rootElement) {
  return async () => {
    const lib = await _chartDownloadMenu_loadHtmlToImage();
    const prevDisplay = rootElement.style.display;
    rootElement.style.display = "inline-block";
    try {
      return await lib.toBlob(rootElement, {
        pixelRatio: 2,
        backgroundColor: "#ffffff",
        cacheBust: true,
      });
    } finally {
      rootElement.style.display = prevDisplay;
    }
  };
}


/**
 * Composite-aware SVG export. Mirror of compositePng but emits an
 * `<svg><foreignObject>` envelope via html-to-image's toSvg, so HTML
 * legends + captions + multi-SVG facets all make it into the exported
 * SVG — matching what compositePng captures for PNG. Returns a raw
 * SVG string (caller wraps in a Blob).
 *
 * Caveat: the resulting SVG renders correctly in browsers + most
 * preview tools but Illustrator's `<foreignObject>` support is patchy.
 * For Illustrator-edit workflows, route through the legacy single-SVG
 * serialise path on a non-composite rootElement (e.g. the inner SVG).
 * The honest "PNG-equivalent SVG" is the right default for everyone
 * else (Pete 2026-06-05).
 */
function compositeSvg(rootElement) {
  return async () => {
    const lib = await _chartDownloadMenu_loadHtmlToImage();
    const prevDisplay = rootElement.style.display;
    rootElement.style.display = "inline-block";
    try {
      const dataUrl = await lib.toSvg(rootElement, {
        backgroundColor: "#ffffff",
        cacheBust: true,
      });
      const prefix = "data:image/svg+xml;charset=utf-8,";
      if (dataUrl.startsWith(prefix)) return decodeURIComponent(dataUrl.slice(prefix.length));
      const b64Prefix = "data:image/svg+xml;base64,";
      if (dataUrl.startsWith(b64Prefix)) return atob(dataUrl.slice(b64Prefix.length));
      return dataUrl;
    } finally {
      rootElement.style.display = prevDisplay;
    }
  };
}


/**
 * Serialise an SVG element so it renders standalone (in Illustrator
 * or via <img>.src). Ensures xmlns + xmlns:xlink + width + height
 * attributes are set on the clone. Doesn't mutate the live SVG.
 */
function _chartDownloadMenu_serializeSvg(svg) {
  const clone = svg.cloneNode(true);
  if (!clone.getAttribute("xmlns")) {
    clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
  }
  if (!clone.getAttribute("xmlns:xlink")) {
    clone.setAttribute("xmlns:xlink", "http://www.w3.org/1999/xlink");
  }
  const bbox = svg.getBoundingClientRect();
  if (!clone.getAttribute("width"))  clone.setAttribute("width",  bbox.width);
  if (!clone.getAttribute("height")) clone.setAttribute("height", bbox.height);
  return new XMLSerializer().serializeToString(clone);
}


/**
 * Rasterise an SVG element to a PNG Blob at the given scale.
 * Composites onto a white background — transparent PNGs paste
 * badly into slides and docs.
 *
 * @param {SVGElement} svg
 * @param {number} [scale=2] - device-pixel-ratio multiplier
 * @returns {Promise<Blob>}
 */
function _chartDownloadMenu_svgToPng(svg, scale) {
  const dpr = scale || 2;
  const svgString = _chartDownloadMenu_serializeSvg(svg);
  const bbox = svg.getBoundingClientRect();
  const svgBlob = new Blob([svgString], { type: "image/svg+xml;charset=utf-8" });
  const svgUrl = URL.createObjectURL(svgBlob);
  return new Promise((resolve, reject) => {
    const im = new Image();
    im.onload = () => {
      const canvas = document.createElement("canvas");
      canvas.width  = Math.round(bbox.width  * dpr);
      canvas.height = Math.round(bbox.height * dpr);
      const ctx = canvas.getContext("2d");
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(im, 0, 0, canvas.width, canvas.height);
      canvas.toBlob((blob) => {
        URL.revokeObjectURL(svgUrl);
        if (blob) resolve(blob);
        else      reject(new Error("canvas.toBlob returned null"));
      }, "image/png");
    };
    im.onerror = (e) => {
      URL.revokeObjectURL(svgUrl);
      reject(e);
    };
    im.src = svgUrl;
  });
}


/**
 * Rasterise an arbitrary DOM element (HTML or SVG) to a PNG Blob via
 * an `<svg><foreignObject>` envelope. Useful for compositing a chart
 * with its custom HTML legend into a single PNG — the foreignObject
 * trick lets Image rasterise an inlined fragment of the live DOM.
 *
 * Caveats:
 *  - Only inline styles are picked up (external CSS won't load inside
 *    the foreignObject — clone the element with its computed styles
 *    inlined if you need that).
 *  - Web fonts may fall back to system fonts in the rasterised output.
 *  - Live <canvas> contents inside the wrapper won't render through
 *    foreignObject — extract the canvas's pixel data via drawImage
 *    instead, then composite.
 *
 * @param {HTMLElement} el      - the element to rasterise
 * @param {number}      [scale=2] - device-pixel-ratio multiplier
 * @returns {Promise<Blob>}
 */
function elementToPngBlob(el, scale) {
  const dpr = scale || 2;
  const rect = el.getBoundingClientRect();
  const W = Math.max(1, Math.ceil(rect.width));
  const H = Math.max(1, Math.ceil(rect.height));

  // Wrap a deep clone of the element in an SVG foreignObject envelope.
  // Cloning prevents foreignObject ↔ live-DOM ownership tangles when
  // the Image rasteriser parses the SVG string back into a doc.
  const clone = el.cloneNode(true);
  const xhtmlWrap = document.createElement("div");
  xhtmlWrap.setAttribute("xmlns", "http://www.w3.org/1999/xhtml");
  xhtmlWrap.style.background = "#ffffff";
  xhtmlWrap.style.display = "inline-block";
  xhtmlWrap.appendChild(clone);

  const fo = document.createElementNS("http://www.w3.org/2000/svg", "foreignObject");
  fo.setAttribute("x", "0");
  fo.setAttribute("y", "0");
  fo.setAttribute("width",  String(W));
  fo.setAttribute("height", String(H));
  fo.appendChild(xhtmlWrap);

  const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
  svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
  svg.setAttribute("width",  String(W));
  svg.setAttribute("height", String(H));
  svg.appendChild(fo);

  const xml = new XMLSerializer().serializeToString(svg);
  const blob = new Blob([xml], { type: "image/svg+xml;charset=utf-8" });
  const url = URL.createObjectURL(blob);

  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement("canvas");
      canvas.width  = W * dpr;
      canvas.height = H * dpr;
      const ctx = canvas.getContext("2d");
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      canvas.toBlob((b) => {
        URL.revokeObjectURL(url);
        if (b) resolve(b);
        else   reject(new Error("canvas.toBlob returned null"));
      }, "image/png");
    };
    img.onerror = (e) => { URL.revokeObjectURL(url); reject(e); };
    img.src = url;
  });
}


/**
 * Inject the helper's CSS once per page (idempotent — the style
 * element is identified by id and skipped on subsequent calls).
 */
function _chartDownloadMenu_ensureStyle() {
  if (document.getElementById("cdm-style")) return;
  const style = document.createElement("style");
  style.id = "cdm-style";
  style.textContent = [
    // Wrapper sizes to its chart content so there's no right-side
    // whitespace when the chart is narrower than the page column.
    // Without this the wrapper was block-level full-width and any
    // chart smaller than its column rendered with trailing whitespace
    // (Pete 2026-06-05 on the test sandbox; same effect was visible
    // in obs_month_overlay narrow plots).
    ".cdm-wrapper { display: inline-block; max-width: 100%; }",
    ".cdm-row { display: flex; justify-content: flex-end; margin-top: 6px; }",
    ".cdm-split-group { position: relative; display: inline-flex; }",
    ".cdm-primary, .cdm-caret {",
    "  font: inherit;",
    "  font-size: 0.85em;",
    "  font-weight: 500;",
    "  padding: 5px 12px;",
    // Darker default so the button reads against the chart background
    // (was a near-invisible white-on-white outline — Pete flagged it
    // as too faint on 2026-05-21).
    "  background: #e8e8e8;",
    "  color: #222;",
    "  border: 1px solid #888;",
    "  cursor: pointer;",
    "  line-height: 1.2;",
    "}",
    ".cdm-primary { border-radius: 3px 0 0 3px; border-right: none; }",
    ".cdm-caret   { border-radius: 0 3px 3px 0; padding: 5px 10px; }",
    ".cdm-primary:hover, .cdm-caret:hover { background: #d4d4d4; }",
    ".cdm-primary:focus, .cdm-caret:focus { outline: 2px solid #4a90e2; outline-offset: -2px; }",
    ".cdm-menu {",
    "  position: absolute;",
    "  top: 100%;",
    "  right: 0;",
    "  margin: 2px 0 0;",
    "  padding: 4px 0;",
    "  list-style: none;",
    "  background: #fff;",
    "  border: 1px solid #ccc;",
    "  border-radius: 3px;",
    "  box-shadow: 0 2px 6px rgba(0,0,0,0.12);",
    "  z-index: 10;",
    "  min-width: 180px;",
    "}",
    ".cdm-menu button {",
    "  font: inherit;",
    "  font-size: 0.85em;",
    "  display: block;",
    "  width: 100%;",
    "  text-align: left;",
    "  padding: 5px 12px;",
    "  background: none;",
    "  border: none;",
    "  cursor: pointer;",
    "}",
    ".cdm-menu button:hover:not([disabled]) { background: #f4f4f4; }",
    ".cdm-menu button:focus { outline: 2px solid #4a90e2; outline-offset: -2px; }",
    ".cdm-menu button[disabled] { color: #aaa; cursor: not-allowed; }",
  ].join("\n");
  document.head.appendChild(style);
}


/**
 * Build the split-button DOM. Returns { group, primary, caret, menu,
 *   show, hide } so the wrapper can wire global keydown / click-outside
 *   handlers.
 */
function _chartDownloadMenu_buildSplitButton({ onPng, onSvg, onCsv, pngAvailable, svgAvailable, csvAvailable }) {
  // Backwards compat: callers that pass only svgAvailable (the original
  // API, when PNG was always the SVG-rasterised path) still work — the
  // primary button stays gated by SVG presence in that case.
  if (pngAvailable === undefined) pngAvailable = svgAvailable;
  const primary = document.createElement("button");
  primary.type = "button";
  primary.className = "cdm-primary";
  primary.textContent = "Download PNG";
  primary.setAttribute("aria-label", "Download chart as PNG");
  primary.disabled = !pngAvailable;
  if (pngAvailable) primary.onclick = onPng;

  const caret = document.createElement("button");
  caret.type = "button";
  caret.className = "cdm-caret";
  caret.setAttribute("aria-haspopup", "true");
  caret.setAttribute("aria-expanded", "false");
  caret.setAttribute("aria-label", "Other download formats");
  caret.innerHTML = "&#9662;"; // ▾

  const menu = document.createElement("ul");
  menu.className = "cdm-menu";
  menu.setAttribute("role", "menu");
  menu.hidden = true;

  const show = () => {
    menu.hidden = false;
    caret.setAttribute("aria-expanded", "true");
    const first = menu.querySelector("button:not([disabled])");
    if (first) first.focus();
  };
  const hide = () => {
    menu.hidden = true;
    caret.setAttribute("aria-expanded", "false");
  };

  const mkItem = (label, fn, enabled) => {
    const li = document.createElement("li");
    const btn = document.createElement("button");
    btn.type = "button";
    btn.setAttribute("role", "menuitem");
    btn.textContent = label;
    btn.disabled = !enabled;
    if (enabled) btn.onclick = () => { hide(); fn(); };
    li.appendChild(btn);
    return li;
  };
  menu.appendChild(mkItem("Download as SVG",   onSvg, svgAvailable));
  menu.appendChild(mkItem("Download data (CSV)", onCsv, csvAvailable));

  caret.onclick = () => (menu.hidden ? show() : hide());

  // Keyboard:
  //  - Enter on primary triggers PNG (button default behaviour, no extra handler needed)
  //  - ArrowDown on either primary or caret opens the menu
  //  - Escape closes the menu and returns focus
  const onKeyOpen = (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); show(); }
  };
  primary.addEventListener("keydown", onKeyOpen);
  caret.addEventListener("keydown", (e) => {
    onKeyOpen(e);
    if (e.key === "Escape") { hide(); primary.focus(); }
  });
  menu.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { hide(); caret.focus(); }
  });

  const group = document.createElement("div");
  group.className = "cdm-split-group";
  group.appendChild(primary);
  group.appendChild(caret);
  group.appendChild(menu);

  return { group, primary, caret, menu, show, hide };
}


/**
 * Wrap a chart element with a download split-button menu.
 *
 * Primary action: PNG (2× DPR).
 * Caret menu: SVG, CSV.
 * Split-button sits BELOW the chart.
 *
 * Menu items are auto-disabled when their source is unavailable
 * (no SVG → PNG + SVG disabled; no data → CSV disabled).
 *
 * @param {HTMLElement|SVGElement} chartElement - The chart to wrap.
 *                                                Plot.plot output
 *                                                works directly.
 * @param {object} [opts]
 * @param {string}        [opts.filename]   - Base name without
 *                                            extension. The helper
 *                                            appends .png / .svg
 *                                            / .csv. Falls back to
 *                                            `chart_<timestamp>`.
 * @param {Array<object>} [opts.data]       - Dataframe backing the
 *                                            chart. Required for CSV.
 * @param {Array<string>} [opts.csvColumns] - Explicit column order
 *                                            for CSV; otherwise the
 *                                            keys of data[0].
 * @param {Function}      [opts.pngOverride] - Async function returning
 *                                            a Blob — used in place of
 *                                            the default SVG → PNG
 *                                            rasterise. Lets non-SVG
 *                                            charts (canvas composites,
 *                                            for example) plug into the
 *                                            same split-button UX.
 * @param {boolean}       [opts.disableSvg] - Force-hide the SVG menu
 *                                            item even when an SVG is
 *                                            present (useful when the
 *                                            chart's "real" output is a
 *                                            canvas composite the SVG
 *                                            alone wouldn't capture).
 * @returns {HTMLElement} A div containing the chart on top and the
 *                       split-button row below.
 */
function chartDownloadMenu(chartElement, opts) {
  const o = opts || {};
  const baseName = o.filename || ("chart_" + Date.now());
  const data = o.data;
  const csvColumns = o.csvColumns;
  const hasData = Array.isArray(data) && data.length > 0;
  // Auto-detect composite shapes (multi-SVG grids, SVG + HTML legend
  // wrappers, pure HTML tables). For these, route BOTH PNG and SVG
  // through html-to-image so the exports match what's rendered — Pete
  // 2026-06-05: legacy single-SVG SVG export dropped the legend +
  // caption on the p4 polar plot. Callers override via opts.pngOverride
  // / opts.svgOverride / opts.disableSvg as needed.
  const needsComposite = _chartDownloadMenu_needsCompositePng(chartElement);
  const pngOverride = o.pngOverride || (needsComposite ? compositePng(chartElement) : null);
  const svgOverride = o.svgOverride || (needsComposite ? compositeSvg(chartElement) : null);
  const disableSvg = !!o.disableSvg;

  // Find the SVG for the legacy fast-path SVG export. CSV doesn't need it.
  const svg = _chartDownloadMenu_findSvg(chartElement);
  // PNG / SVG availability: an override handler always wins; otherwise
  // we need a findable SVG in the rootElement.
  const pngAvailable = typeof pngOverride === "function" || !!svg;
  const svgAvailable = (typeof svgOverride === "function" || !!svg) && !disableSvg;

  // Export actions
  const onPng = async () => {
    try {
      const blob = pngOverride
        ? await pngOverride()
        : await _chartDownloadMenu_svgToPng(svg, 2);
      _chartDownloadMenu_triggerDownload(blob, baseName + ".png");
    } catch (e) {
      console.error("chartDownloadMenu PNG export failed", e);
    }
  };
  const onSvg = async () => {
    try {
      const svgString = svgOverride
        ? await svgOverride()
        : _chartDownloadMenu_serializeSvg(svg);
      const blob = new Blob([svgString], { type: "image/svg+xml;charset=utf-8" });
      _chartDownloadMenu_triggerDownload(blob, baseName + ".svg");
    } catch (e) {
      console.error("chartDownloadMenu SVG export failed", e);
    }
  };
  const onCsv = () => {
    const csv = _chartDownloadMenu_toCsv(data, csvColumns);
    // UTF-8 BOM so Excel recognises diacritics in admin names etc.
    const blob = new Blob(["﻿", csv], { type: "text/csv;charset=utf-8" });
    _chartDownloadMenu_triggerDownload(blob, baseName + ".csv");
  };

  _chartDownloadMenu_ensureStyle();
  const sb = _chartDownloadMenu_buildSplitButton({
    onPng, onSvg, onCsv,
    pngAvailable,
    svgAvailable,
    csvAvailable: hasData,
  });

  const row = document.createElement("div");
  row.className = "cdm-row";
  row.appendChild(sb.group);

  const wrapper = document.createElement("div");
  wrapper.className = "cdm-wrapper";
  wrapper.appendChild(chartElement);
  wrapper.appendChild(row);

  // Click-outside closes the menu. Scoped to the wrapper instance.
  const onDocClick = (e) => {
    if (!wrapper.contains(e.target)) sb.hide();
  };
  document.addEventListener("click", onDocClick);
  // Clean up the listener if the wrapper is removed from the DOM
  // (e.g. when OJS re-runs the cell and replaces it). MutationObserver
  // on the parent is overkill — a WeakRef-style cleanup via a single
  // MutationObserver at document level handles this generically.
  const mo = new MutationObserver(() => {
    if (!document.body.contains(wrapper)) {
      document.removeEventListener("click", onDocClick);
      mo.disconnect();
    }
  });
  mo.observe(document.body, { childList: true, subtree: true });

  return wrapper;
}

/**
 * Like chartDownloadMenu but returns ONLY the split-button element,
 * for inclusion in a captionDetails `plot-footer-row` alongside the
 * "About this plot" disclosure. The chartElement arg is used only to
 * find the SVG for PNG/SVG export — it's NOT wrapped or inserted into
 * the DOM. The caller is responsible for placing the returned button
 * wherever it wants (typically as the `downloadBtn` argument to
 * captionDetails).
 *
 * Same options as chartDownloadMenu: filename, data, csvColumns,
 * pngOverride, disableSvg.
 *
 * @returns {HTMLElement} The split-button group element.
 */
function chartDownloadButton(chartElement, opts) {
  const o = opts || {};
  const baseName = o.filename || ("chart_" + Date.now());
  const data = o.data;
  const csvColumns = o.csvColumns;
  const hasData = Array.isArray(data) && data.length > 0;
  // Same composite auto-detection as chartDownloadMenu — keeps the
  // button variant consistent with the wrapper variant.
  const needsComposite = _chartDownloadMenu_needsCompositePng(chartElement);
  const pngOverride = o.pngOverride || (needsComposite ? compositePng(chartElement) : null);
  const svgOverride = o.svgOverride || (needsComposite ? compositeSvg(chartElement) : null);
  const disableSvg = !!o.disableSvg;

  const svg = _chartDownloadMenu_findSvg(chartElement);
  const pngAvailable = typeof pngOverride === "function" || !!svg;
  const svgAvailable = (typeof svgOverride === "function" || !!svg) && !disableSvg;

  const onPng = async () => {
    try {
      const blob = pngOverride
        ? await pngOverride()
        : await _chartDownloadMenu_svgToPng(svg, 2);
      _chartDownloadMenu_triggerDownload(blob, baseName + ".png");
    } catch (e) {
      console.error("chartDownloadButton PNG export failed", e);
    }
  };
  const onSvg = async () => {
    try {
      const svgString = svgOverride
        ? await svgOverride()
        : _chartDownloadMenu_serializeSvg(svg);
      const blob = new Blob([svgString], { type: "image/svg+xml;charset=utf-8" });
      _chartDownloadMenu_triggerDownload(blob, baseName + ".svg");
    } catch (e) {
      console.error("chartDownloadButton SVG export failed", e);
    }
  };
  const onCsv = () => {
    const csv = _chartDownloadMenu_toCsv(data, csvColumns);
    const blob = new Blob(["﻿", csv], { type: "text/csv;charset=utf-8" });
    _chartDownloadMenu_triggerDownload(blob, baseName + ".csv");
  };

  _chartDownloadMenu_ensureStyle();
  const sb = _chartDownloadMenu_buildSplitButton({
    onPng, onSvg, onCsv,
    pngAvailable,
    svgAvailable,
    csvAvailable: hasData,
  });

  // Click-outside scoped to the button group itself. Cleanup when the
  // button is detached from the DOM (e.g. on OJS cell re-eval).
  const onDocClick = (e) => {
    if (!sb.group.contains(e.target)) sb.hide();
  };
  document.addEventListener("click", onDocClick);
  const mo = new MutationObserver(() => {
    if (!document.body.contains(sb.group)) {
      document.removeEventListener("click", onDocClick);
      mo.disconnect();
    }
  });
  mo.observe(document.body, { childList: true, subtree: true });

  return sb.group;
}
