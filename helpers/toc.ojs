function atlasTOC({
  selector = "h1",
  heading = "In this notebook",
  skip = ["notebook-title"],
  activeClass = "active",
} = {}) {
  // Ensure the floating-TOC stylesheet is in document <head>. Idempotent —
  // both the main notebook and the sandbox notebook share this single
  // source of truth so their floating sidebars look identical without
  // duplicating CSS in each .qmd file.
  ensureAtlasTOCStyles();
  return Generators.observe((notify) => {
    let headings = [];
    let links = [];
    let lastSig = "";
    let timeout;

    // Main TOC refresh
    function observed() {
      clearTimeout(timeout);
      timeout = setTimeout(() => {
        // Collect headings except skipped ones. Also skip headings that live
        // inside a `<figure>` (Plot.plot's `title:` option renders an <h2>
        // inside the figure element — those are chart titles, not page
        // sections) or inside any container whose `data-toc-skip="true"` is
        // set on an ancestor.
        const h = Array.from(document.querySelectorAll(selector)).filter(
          (d) =>
            !d.closest("figure") &&
            !d.closest("[data-toc-skip='true']") &&
            d.dataset.tocSkip !== "true" &&
            !skip.some(
              (value) =>
                d.parentElement.id === value ||
                d.id === value ||
                d.textContent === value ||
                d.className === value,
            ),
        );

        // If no change, do nothing. The signature includes the rendered
        // label text, not just element identity: OJS-inline headings
        // (`# \`{ojs} title\``) mount as EMPTY spans and only fill in when
        // the OJS graph resolves — same elements, new text — so an
        // identity-only check would freeze the TOC on the empty boot state.
        const sig = h
          .map((el) => el.dataset.tocLabel ?? el.textContent)
          .join("\u0001");
        if (
          h.length === headings.length &&
          h.every((el, i) => el === headings[i]) &&
          sig === lastSig
        )
          return;
        headings = h;
        lastSig = sig;

        // Build links
        links = headings.map(createLink);

        // Render TOC
        notify(html`
          <div class="atlas-toc">
            <div class="atlas-toc-heading">${heading}</div>

            ${headings.length ? links : html`<div>No headings found.</div>`}
          </div>
        `);

        onScroll();
      }, 5);
    }

    // Create clickable link. Honour an explicit `data-toc-label` attr on the
    // heading element so callers can override the rendered label with a short
    // form (long h1/h2 titles become very tall sidebar entries). Falls back to
    // the heading's textContent when the attr is missing.
    function createLink(h) {
      const id = h.parentElement.id;
      const label = h.dataset.tocLabel ?? h.textContent;
      // Indent depth from heading level — h1 = level 1 (no indent), h2 = 2,
      // h3 = 3, etc. Each level adds 12 px left padding so subsections nest
      // visually under their parent heading in the floating TOC.
      const level = parseInt((h.tagName || "H1").slice(1), 10) || 1;
      const link = html`<a class="toc-link toc-level-${level}"
        href="#${id}"
        style="padding-left: ${(level - 1) * 12}px;">${DOM.text(label)}</a>`;
      link.onclick = (e) => {
        e.preventDefault();
        h.scrollIntoView({ behavior: "smooth" });
        setActiveLink(link);
      };
      return link;
    }

    // Highlight active link
    function setActiveLink(activeLink) {
      links.forEach((link) =>
        link.classList.toggle(activeClass, link === activeLink),
      );
    }

    // Scroll spy logic
    function onScroll() {
      if (!headings.length) return;

      const closest =
        links[
          headings
            .map((h) => Math.abs(h.getBoundingClientRect().top))
            .reduce(
              (minIdx, dist, i, arr) => (dist < arr[minIdx] ? i : minIdx),
              0,
            )
        ];

      setActiveLink(closest);
    }

    // Watch DOM for changes
    const observer = new MutationObserver(observed);
    observer.observe(document.body, { childList: true, subtree: true });
    window.addEventListener("scroll", onScroll);

    observed();
    onScroll();

    // Cleanup
    return () => {
      observer.disconnect();
      window.removeEventListener("scroll", onScroll);
    };
  });
}

// Shared floating-TOC stylesheet. Injected into document <head> the first
// time atlasTOC is called from any notebook (idempotent). Main notebook +
// sandbox notebook(s) both call atlasTOC and so inherit the same look —
// previously every notebook needed to redeclare the link styling inline.
// Heading-level nesting:
//   .toc-level-1 — page-group H1 (Historical trends / Future projections /
//      Methods / References): bold, slightly larger so the user can pick
//      out top-level groups at a glance.
//   .toc-level-2 — section H2 (Year overlay / Climate spiral / …): regular
//      weight with a thin left border, indenting under its level-1 parent.
//   .toc-level-3 — sub-section H3: lighter colour, deeper indent.
// Combined with the inline `padding-left` set per element by createLink().
function ensureAtlasTOCStyles() {
  if (typeof document === "undefined") return;
  if (document.getElementById("atlas-toc-styles")) return;
  const s = document.createElement("style");
  s.id = "atlas-toc-styles";
  s.textContent = `
    .atlas-toc {
      position: fixed;
      top: 78px;
      right: 22px;
      /* Never wider than the free gutter beside the 1180px content
         column (_quarto.yml grid.body-width), so the open TOC cannot
         overlap the main pane. 30px = 22px edge offset + 8px gap.
         Below ~1440px viewport the clamp bottoms out at 100px; the
         notebook's auto-collapse (< 1480px) hides it before then. */
      width: clamp(100px, calc((100vw - 1180px) / 2 - 30px), 300px);
      box-sizing: border-box;
      max-height: 78vh;
      overflow-y: auto;
      padding: 10px 16px;
      border-radius: 6px;
      background: rgba(248, 250, 250, 0.95);
      box-shadow: -2px 2px 8px rgba(0, 0, 0, 0.15);
      font-family: system-ui, sans-serif;
      z-index: 10;
      backdrop-filter: blur(4px);
    }
    .atlas-toc-heading {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #331;
      margin-bottom: 6px;
    }
    .atlas-toc a.toc-link {
      display: block;
      padding: 2px 0;
      text-decoration: none;
      color: #442;
      font-size: 11px;
      line-height: 1.4;
    }
    .atlas-toc a.toc-link.toc-level-1 {
      font-weight: 600;
      font-size: 11.5px;
      margin-top: 6px;
      color: #331;
    }
    .atlas-toc a.toc-link.toc-level-1:first-child { margin-top: 0; }
    .atlas-toc a.toc-link.toc-level-2 {
      border-left: 1px solid #d8d4cc;
      margin-left: 4px;
      font-size: 10.5px;
    }
    .atlas-toc a.toc-link.toc-level-3 {
      border-left: 1px solid #e8e4dc;
      margin-left: 16px;
      font-size: 10.5px;
      color: #665;
    }
    .atlas-toc a.toc-link:hover { color: #d2a017; }
    .atlas-toc a.toc-link.active {
      font-weight: 600;
      color: #d2a017;
    }
  `;
  document.head.appendChild(s);
}
